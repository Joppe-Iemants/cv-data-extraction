{
  "name": "ocr_baseline",
  "split": "development",
  "document_ids": null,
  "exclude_sources": ["vdab"],
  "repetitions": 3,
  "monitoring": {
    "memory": false,
    "sample_interval_ms": 10
  },
  "stages": [
    {
      "name": "render_pages",
      "method": "render_pdf",
      "settings": {
        "dpi": 300
      }
    },
    {
      "name": "recognize_text",
      "method": "tesseract_ocr",
      "settings": {
        "language": "eng",
        "page_segmentation": 3,
        "timeout_seconds": 120
      }
    },
    {
      "name": "prepare_text",
      "method": "join_page_text",
      "settings": {
        "page_separator": "\n\n"
      }
    },
    {
      "name": "structure_cv",
      "method": "llm_structuring",
      "settings": {
        "model": "qwen3:8b",
        "base_url": "http://localhost:11434",
        "timeout_seconds": 1800,
        "options": {
          "temperature": 0,
          "seed": 42,
          "num_ctx": 32768,
          "num_predict": 8192
        },
        "keep_alive": "5m"
      }
    }
  ]
}